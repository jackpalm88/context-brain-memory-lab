# Context Brain Memory Lab — local dev environment template.
# Copy to .env and adjust. Never commit .env with real secrets.
#
# Usage:
#   cp .env.example .env
#   docker compose up --build

# ---------------------------------------------------------------------------
# Port overrides — avoids clashing with existing local Postgres/API.
# ---------------------------------------------------------------------------
CBML_PG_PORT=5433
CBML_API_PORT=8088

# ---------------------------------------------------------------------------
# Postgres credentials (local dev only).
# Change CBML_PG_PASSWORD for any network-exposed stack.
# ---------------------------------------------------------------------------
CBML_PG_DB=cbml
CBML_PG_USER=cbml
CBML_PG_PASSWORD=cbml-local-dev

# ---------------------------------------------------------------------------
# Local-dev auth subject.
# compose_bootstrap.sh seeds this into auth_subjects automatically.
# local_dev_bypass mode uses this as the request subject — local only.
# ---------------------------------------------------------------------------
CBML_DEV_SUBJECT_ID=11111111-1111-1111-1111-111111111111

# ---------------------------------------------------------------------------
# Provider selection.
# Keep 'none' for deterministic baseline (no provider keys required).
# Set to 'openai' / 'anthropic' and supply API keys for vector/LLM paths.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
EMBEDDING_PROVIDER=none

# ---------------------------------------------------------------------------
# Auth mode.
# local_dev_bypass  — for docker compose quickstart (local only).
# api_key           — for anything network-exposed.
# ---------------------------------------------------------------------------
MEMORY_LAB_AUTH_MODE=local_dev_bypass
MEMORY_LAB_AUTH_ALLOW_LOCAL_DEV_BYPASS=true
